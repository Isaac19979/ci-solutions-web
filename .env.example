# Copia este archivo como ".env" y completa tus valores reales.
# NUNCA subas el archivo ".env" (con tus claves reales) a GitHub.

# API key de Resend (la obtienes gratis en https://resend.com despues de crear tu cuenta)
RESEND_API_KEY=tu_api_key_de_resend_aqui

# Correo donde quieres recibir los mensajes del formulario de contacto
CONTACT_EMAIL=correo@gmail.com

# Puerto local (Render asigna el suyo automaticamente en produccion, esto es solo para tu maquina)
PORT=3000
